{
  "env": {
    "EDITOR": "nvim"
  },
  "permissions": {
    "allow": [
      "Bash(mkdir -p /home/jack/git)",
      "Bash(ls /home/jack/.claude/skills*)",
      "Bash(~/dotfiles/claude/skills/later/run *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git merge-base *)"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {},
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "theme": "light"
}
